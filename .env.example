# Copy to .env.local. Keep credentials server-side; never commit this private file.
MODEL_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
STUDIO_ALLOW_LIVE_CALLS=0
META_REASONING_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENTATION_MODEL=sam-3.1
GHOST_VIDEO_MODEL=fal-ai/veo3.1/first-last-frame-to-video
# Uses exact Blender start/end frames; unchanged end states reuse the first render.
# Seedance 2.5 remains supported, but rejected our realistic fictional actor references.
# Optional absolute paths for your installation:
# GHOST_PRODUCTION_ROOT=/path/to/productions/ghost-director-hackathon
# GHOST_BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# Optional trusted Studio OS checkout for its role guidance.
# Without this, the standalone repository uses original bundled role contracts.
# GHOST_STUDIO_ROOT=/path/to/studio-os
